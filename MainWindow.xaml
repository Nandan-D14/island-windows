<Window x:Class="Island.MainWindow" Icon="logo.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="700" Height="500" FontFamily="Segoe UI Variable Display, Segoe UI"
        Foreground="White">
  <Window.Resources>
    <!-- modern overlay scrollbar: thin pill thumb, no arrows, brightens on hover -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="Margin" Value="4,2,0,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="T" CornerRadius="3" Background="#40FFFFFF" Margin="1,0"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#80FFFFFF"/><Setter TargetName="T" Property="Margin" Value="0"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="#A0FFFFFF"/><Setter TargetName="T" Property="Margin" Value="0"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <SolidColorBrush x:Key="Dim" Color="#8CFFFFFF"/>
    <SolidColorBrush x:Key="Tile" Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>

    <!-- round icon button -->
    <Style x:Key="Ctl" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="20" MinWidth="40" Height="40" Padding="6,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#22FFFFFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#38FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- small round icon button (section headers) -->
    <Style x:Key="Mini" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="11" Width="22" Height="22">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#26FFFFFF"/><Setter Property="Foreground" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- pill text button (timer presets) -->
    <Style x:Key="Chip" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{StaticResource Tile}" CornerRadius="13" Height="26" Padding="12,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#33FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- segmented control: put Seg buttons inside a SegTrack; the code marks the chosen one with Tag="on" -->
    <Style x:Key="SegTrack" TargetType="Border">
      <Setter Property="Background" Value="#14FFFFFF"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Seg" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10" Height="20" Padding="10,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
              <Trigger Property="Tag" Value="on">
                <Setter Property="Background" Value="#38FFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- on/off switch -->
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="t" Width="34" Height="20" CornerRadius="10" Background="#33FFFFFF">
              <Ellipse x:Name="k" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="t" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="k" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- plain text button -->
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="4,2"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- grouped settings list: a card of rows split by hairlines -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#12FFFFFF"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Row" TargetType="Grid">
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style x:Key="Hair" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="#14FFFFFF"/>
    </Style>

    <!-- quick toggle tile -->
    <Style x:Key="Toggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="5,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" Background="{StaticResource Tile}" CornerRadius="21" Width="42" Height="42">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#33FFFFFF"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Action" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="5,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{StaticResource Tile}" CornerRadius="21" Width="42" Height="42">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#33FFFFFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#48FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- tab -->
    <Style x:Key="Tab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="GroupName" Value="Tabs"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" CornerRadius="12" Width="30" Height="24" Margin="0,0,1,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#2EFFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- text sub-tab (inside merged tabs) -->
    <Style x:Key="Sub" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" CornerRadius="10" Height="20" Padding="8,0" Margin="0,0,2,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- mac-like slider -->    <Style x:Key="FillBar" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
        <Border Background="White" Height="6" CornerRadius="3,0,0,3"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="EmptyBar" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
        <Border Background="Transparent"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Sld" TargetType="Slider">
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Height="20">
          <Border Height="6" CornerRadius="3" Background="#38FFFFFF" VerticalAlignment="Center"/>
          <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource FillBar}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource EmptyBar}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
            <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
              <Ellipse Width="14" Height="14" Fill="White"/>
            </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border Background="{StaticResource Tile}" CornerRadius="11" Height="30" Padding="10,0">
          <Grid>
            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="#66FFFFFF" VerticalAlignment="Center" Visibility="Collapsed"/>
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="Text" Value=""><Setter TargetName="ph" Property="Visibility" Value="Visible"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Area" TargetType="TextBox">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="AcceptsReturn" Value="True"/>
      <Setter Property="AcceptsTab" Value="True"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border Background="{StaticResource Tile}" CornerRadius="14" Padding="10,8">
          <Grid>
            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="#66FFFFFF" Margin="2,0" Visibility="Collapsed"/>
            <ScrollViewer x:Name="PART_ContentHost"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="Text" Value=""><Setter TargetName="ph" Property="Visibility" Value="Visible"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="Big" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>

  <Grid>
  <Border x:Name="Pill" CornerRadius="0,0,16,16" Width="130" Height="32" BorderThickness="1.2,0,1.2,1.2"
          VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0"
          ClipToBounds="True" MouseEnter="OnEnter" MouseLeave="OnLeave"
          AllowDrop="True" DragEnter="OnDragEnter" Drop="OnDrop">
    <!-- light catching the rim -->
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B0FFFFFF" Offset="0"/>
        <GradientStop Color="#18FFFFFF" Offset="0.35"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.65"/>
        <GradientStop Color="#60FFFFFF" Offset="1"/>
      </LinearGradientBrush>
    </Border.BorderBrush>
    <Grid>
      <!-- smoky glass tint over the blurred backdrop -->
      <Border x:Name="Tint" CornerRadius="0,0,15,15" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#80101014" Offset="0"/>
            <GradientStop Color="#A6060609" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <!-- specular sheen -->
      <Border x:Name="Sheen" CornerRadius="0,0,15,15" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#30FFFFFF" Offset="0"/>
            <GradientStop Color="#08FFFFFF" Offset="0.45"/>
            <GradientStop Color="#00FFFFFF" Offset="0.5"/>
            <GradientStop Color="#0CFFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <!-- privacy dots: camera (green) / microphone (orange) in use -->
      <StackPanel x:Name="PrivDots" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,5,0,0"
                  IsHitTestVisible="False" Panel.ZIndex="5">
        <Ellipse x:Name="CamDot" Width="6" Height="6" Fill="#30D158" Margin="0,0,3,0" Visibility="Collapsed"/>
        <Ellipse x:Name="MicDot" Width="6" Height="6" Fill="#FF9F0A" Visibility="Collapsed"/>
        <Ellipse x:Name="ShareDot" Width="6" Height="6" Fill="#FF453A" Margin="3,0,0,0" Visibility="Collapsed"/>
        <Ellipse x:Name="PhoneDot" Width="6" Height="6" Fill="#0A84FF" Margin="3,0,0,0" Visibility="Collapsed"/>
      </StackPanel>

      <!-- ===== Compact live activity ===== -->
      <Grid x:Name="Compact" Margin="8,0">
        <!-- idle glance: weather | time | battery -->
        <Grid x:Name="IdleInfo" Margin="6,0" Visibility="Collapsed">
          <TextBlock x:Name="IdleWx" FontSize="12" Foreground="{StaticResource Dim}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="IdleDnd" FontFamily="{StaticResource Icons}" Text="&#xE708;" FontSize="11" Foreground="#BF5AF2" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="IdleTime" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <!-- unread notifications -->
            <Border x:Name="IdleBadge" Background="#FF453A" CornerRadius="7" MinWidth="14" Height="14" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock x:Name="IdleBadgeText" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="IdleBatIcon" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock x:Name="IdleBat" FontSize="12" Foreground="{StaticResource Dim}" Margin="4,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
        <Border x:Name="MiniArt" Width="22" Height="22" CornerRadius="6" HorizontalAlignment="Left" Visibility="Collapsed">
          <Border.Background><ImageBrush x:Name="MiniArtImg" Stretch="UniformToFill"/></Border.Background>
        </Border>
        <TextBlock x:Name="CompactText" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        <TextBlock x:Name="LiveText" FontSize="12" Foreground="#E6FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="34,0,40,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
        <TextBlock x:Name="TimerMini" FontSize="13" FontWeight="SemiBold" Foreground="#FF9F0A" HorizontalAlignment="Right"
                   VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed"/>
        <StackPanel x:Name="Bars" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
          <Rectangle Width="3" Height="14" Margin="1,0" RadiusX="1.5" RadiusY="1.5" Fill="#FF9F0A" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform/></Rectangle.RenderTransform></Rectangle>
          <Rectangle Width="3" Height="14" Margin="1,0" RadiusX="1.5" RadiusY="1.5" Fill="#FF9F0A" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform/></Rectangle.RenderTransform></Rectangle>
          <Rectangle Width="3" Height="14" Margin="1,0" RadiusX="1.5" RadiusY="1.5" Fill="#FF9F0A" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform/></Rectangle.RenderTransform></Rectangle>
          <Rectangle Width="3" Height="14" Margin="1,0" RadiusX="1.5" RadiusY="1.5" Fill="#FF9F0A" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform/></Rectangle.RenderTransform></Rectangle>
        </StackPanel>
      </Grid>

      <!-- ===== Volume / brightness HUD ===== -->
      <Grid x:Name="Hud" Margin="14,0" Opacity="0" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="HudIcon" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center"/>
        <Grid Grid.Column="1" Height="6" Margin="12,0" VerticalAlignment="Center">
          <Border Background="#38FFFFFF" CornerRadius="3"/>
          <Border x:Name="HudFill" Background="White" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
        </Grid>
        <TextBlock x:Name="HudText" Grid.Column="2" FontSize="12" FontWeight="SemiBold" Width="26" TextAlignment="Right" VerticalAlignment="Center"/>
      </Grid>

      <!-- ===== Notification ===== -->
      <Grid x:Name="Notif" Margin="16,10" Opacity="0" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Accent}" VerticalAlignment="Center">
          <TextBlock x:Name="NotifIcon" FontFamily="{StaticResource Icons}" FontSize="18" Text="&#xEA8F;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border Width="38" Height="38" CornerRadius="10" VerticalAlignment="Center" ClipToBounds="True" IsHitTestVisible="False">
          <Image x:Name="NotifAppImg" Width="30" Height="30"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="NotifApp" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="NotifTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="NotifBody" FontSize="12" Foreground="#C8FFFFFF" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>

      <!-- ===== Voice assistant ===== -->
      <Grid x:Name="AiView" Margin="14,8,8,10" Opacity="0" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Ellipse Width="34" Height="34" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Cursor="Hand" MouseLeftButtonDown="OnOrbTap">
          <Ellipse.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop x:Name="OrbA" Color="#5E9CFF" Offset="0"/>
              <GradientStop x:Name="OrbB" Color="#A85CFF" Offset="1"/>
            </LinearGradientBrush>
          </Ellipse.Fill>
          <Ellipse.RenderTransform><ScaleTransform x:Name="OrbScale"/></Ellipse.RenderTransform>
        </Ellipse>
        <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
          <TextBlock x:Name="AiYou" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="AiSays" FontSize="13" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource Ctl}" FontSize="11" Content="&#xE711;" Click="OnAiClose" VerticalAlignment="Center"/>
      </Grid>

      <!-- ===== Voice, small: a dot + one live caption line ===== -->
      <Grid x:Name="VoiceMini" Margin="12,0,14,0" Opacity="0" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Ellipse x:Name="VoiceDot" Width="14" Height="14" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Cursor="Hand" MouseLeftButtonDown="OnOrbTap">
          <Ellipse.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop x:Name="DotA" Color="#5E9CFF" Offset="0"/>
              <GradientStop x:Name="DotB" Color="#A85CFF" Offset="1"/>
            </LinearGradientBrush>
          </Ellipse.Fill>
          <Ellipse.RenderTransform><ScaleTransform x:Name="DotScale"/></Ellipse.RenderTransform>
        </Ellipse>
        <TextBlock x:Name="VoiceCap" Grid.Column="1" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </Grid>

      <!-- ===== Allow / Deny card (AI wants to do something) ===== -->
      <Grid x:Name="AskView" Margin="16,10,12,10" Opacity="0" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="36" Height="36" CornerRadius="18" Background="#33FF9F0A" VerticalAlignment="Center">
          <TextBlock FontFamily="{StaticResource Icons}" Text="&#xEA18;" FontSize="17" Foreground="#FF9F0A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
          <TextBlock x:Name="AskHead" Style="{StaticResource Label}" Text="GEMINI WANTS TO"/>
          <TextBlock x:Name="AskTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="AskWhy" FontSize="11" Foreground="#C8FFFFFF" TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis"/>
          <!-- exact terminal command being approved -->
          <Border x:Name="AskCmdBox" Background="#40000000" CornerRadius="8" Padding="8,4" Margin="0,5,0,0" Visibility="Collapsed">
            <TextBlock x:Name="AskCmd" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#FFE08A" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis"/>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource Chip}" Content="Deny" Click="OnAskDeny"/>
          <Button x:Name="AskAlways" Style="{StaticResource Chip}" Content="Always" Click="OnAskAlways"/>
          <Button Style="{StaticResource Chip}" Content="Allow" Foreground="#30D158" Click="OnAskAllow"/>
        </StackPanel>
      </Grid>

      <!-- ===== Expanded ===== -->
      <Grid x:Name="Expanded" Margin="16,12,16,14" Opacity="0" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid>
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="TabMedia" Style="{StaticResource Tab}" Content="&#xE8D6;" Checked="OnTab"/>
            <RadioButton x:Name="TabGlance" Style="{StaticResource Tab}" Content="&#xE80F;" Checked="OnTab"/>
            <RadioButton x:Name="TabTimer" Style="{StaticResource Tab}" Content="&#xE916;" Checked="OnTab"/>
            <RadioButton x:Name="TabShelf" Style="{StaticResource Tab}" Content="&#xE7B8;" Checked="OnTab"/>
            <RadioButton x:Name="TabApps" Style="{StaticResource Tab}" Content="&#xE74C;" Checked="OnTab"/>
            <RadioButton x:Name="TabCtl" Style="{StaticResource Tab}" Content="&#xE713;" Checked="OnTab"/>
            <RadioButton x:Name="TabNotifs" Style="{StaticResource Tab}" Checked="OnTab">
              <Grid>
                <TextBlock Text="&#xEA8F;"/>
                <Ellipse x:Name="TabBadge" Width="6" Height="6" Fill="#FF453A" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" Visibility="Collapsed"/>
              </Grid>
            </RadioButton>
            <RadioButton x:Name="TabAi" Style="{StaticResource Tab}" FontFamily="Segoe UI Symbol" FontSize="13" Content="✦" Checked="OnTab"/>
            <!-- page switcher of the merged tab:  ‹ • • • › -->
            <Button x:Name="PrevPage" Style="{StaticResource Mini}" FontSize="9" Content="&#xE76B;" Margin="8,0,0,0" Visibility="Collapsed" Click="OnPrevPage"/>
            <StackPanel x:Name="PageDots" Orientation="Horizontal" VerticalAlignment="Center"/>
            <Button x:Name="NextPage" Style="{StaticResource Mini}" FontSize="9" Content="&#xE76C;" Visibility="Collapsed" Click="OnNextPage"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="WxMini" Visibility="Collapsed"/>
            <TextBlock x:Name="BatIcon" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
            <TextBlock x:Name="BatText" Style="{StaticResource Label}" FontSize="12" Margin="4,0,10,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ClockText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="PageHost" Grid.Row="1" Margin="0,12,0,0">
          <!-- Media -->
          <Grid x:Name="PageMedia">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="56" Height="56" CornerRadius="12" Background="{StaticResource Tile}">
                <Grid>
                  <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8D6;" FontSize="22" Foreground="#55FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Border CornerRadius="12"><Border.Background><ImageBrush x:Name="ArtImg" Stretch="UniformToFill"/></Border.Background></Border>
                </Grid>
              </Border>
              <Button x:Name="LyricsBtn" Grid.Column="1" Style="{StaticResource Mini}" FontSize="13" Content="&#xE7F0;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0" Click="OnLyricsToggle"/>
              <StackPanel Grid.Column="1" Margin="12,0,30,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" Foreground="{StaticResource Dim}" FontSize="13" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,10,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="PosText" Style="{StaticResource Label}"/>
              <Grid x:Name="ProgressTrack" Grid.Column="1" VerticalAlignment="Center" Height="4">
                <Border Background="#33FFFFFF" CornerRadius="2"/>
                <Border x:Name="ProgressFill" Background="White" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
              </Grid>
              <TextBlock x:Name="DurText" Grid.Column="2" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
              <Button Style="{StaticResource Ctl}" FontSize="17" Content="&#xE892;" Click="OnPrev"/>
              <Button x:Name="PlayBtn" Style="{StaticResource Ctl}" FontSize="24" Margin="16,0" Content="&#xE768;" Click="OnPlay"/>
              <Button Style="{StaticResource Ctl}" FontSize="17" Content="&#xE893;" Click="OnNext"/>
            </StackPanel>
          </Grid>

          <!-- Timer -->
          <Grid x:Name="PageTimer" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <TextBlock x:Name="TimerBig" Text="00:00" FontSize="44" FontWeight="Light" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="TimerStartBtn" Style="{StaticResource Ctl}" FontSize="20" Content="&#xE768;" Click="OnTimerStart"/>
                <Button Style="{StaticResource Ctl}" FontSize="16" Content="&#xE72C;" Click="OnTimerReset"/>
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource SegTrack}" HorizontalAlignment="Center" Padding="3">
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Seg}" Content="+1 min" Tag="1" Click="OnTimerAdd"/>
                <Button Style="{StaticResource Seg}" Content="+5 min" Tag="5" Click="OnTimerAdd"/>
                <Button Style="{StaticResource Seg}" Content="+10 min" Tag="10" Click="OnTimerAdd"/>
                <Button Style="{StaticResource Seg}" Content="Focus 25" Tag="25" Click="OnTimerSet"/>
                <Button Style="{StaticResource Seg}" Content="Stopwatch" Click="OnStopwatch"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Calendar -->
          <Grid x:Name="PageCal" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="CalDay" FontSize="13" Foreground="#FF453A" FontWeight="SemiBold"/>
              <TextBlock x:Name="CalDate" FontSize="46" FontWeight="Light" Margin="0,-6,0,-6"/>
              <TextBlock x:Name="CalMonth" Style="{StaticResource Label}" FontSize="12"/>
            </StackPanel>
            <UniformGrid x:Name="CalGrid" Grid.Column="1" Columns="7" VerticalAlignment="Center"/>
          </Grid>

          <!-- System stats -->
          <UniformGrid x:Name="PageStats" Columns="4" Visibility="Collapsed">
            <Border Background="{StaticResource Tile}" CornerRadius="14" Margin="3" Padding="10">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Label}" Text="CPU"/>
                <TextBlock x:Name="CpuText" Style="{StaticResource Big}" Text="--"/>
                <Grid Height="4" Margin="0,8,0,0"><Border Background="#33FFFFFF" CornerRadius="2"/><Border x:Name="CpuBar" Background="#30D158" CornerRadius="2" HorizontalAlignment="Left" Width="0"/></Grid>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource Tile}" CornerRadius="14" Margin="3" Padding="10">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Label}" Text="Memory"/>
                <TextBlock x:Name="RamText" Style="{StaticResource Big}" Text="--"/>
                <Grid Height="4" Margin="0,8,0,0"><Border Background="#33FFFFFF" CornerRadius="2"/><Border x:Name="RamBar" Background="#0A84FF" CornerRadius="2" HorizontalAlignment="Left" Width="0"/></Grid>
                <TextBlock x:Name="RamSub" Style="{StaticResource Label}" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource Tile}" CornerRadius="14" Margin="3" Padding="10">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Label}" Text="Network"/>
                <TextBlock x:Name="NetDown" FontSize="14" FontWeight="SemiBold" Text="↓ --"/>
                <TextBlock x:Name="NetUp" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Dim}" Text="↑ --"/>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource Tile}" CornerRadius="14" Margin="3" Padding="10">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Label}" Text="Battery"/>
                <TextBlock x:Name="BatBig" Style="{StaticResource Big}" Text="--"/>
                <TextBlock x:Name="BatSub" Style="{StaticResource Label}" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <!-- Weather -->
          <Grid x:Name="PageWeather" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="WxCity" Style="{StaticResource Label}" FontSize="12" Text="Locating…"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="WxIcon" FontFamily="Segoe UI Symbol" FontSize="30" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="WxTemp" FontSize="42" FontWeight="Light" Text="--"/>
              </StackPanel>
              <TextBlock x:Name="WxDesc" FontSize="13" FontWeight="SemiBold"/>
              <TextBlock x:Name="WxSub" Style="{StaticResource Label}" Margin="0,2,0,0"/>
            </StackPanel>
            <UniformGrid x:Name="WxDays" Grid.Column="1" Rows="1" VerticalAlignment="Center"/>
          </Grid>

          <!-- To-do -->
          <Grid x:Name="PageTodo" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBox x:Name="TodoInput" Style="{StaticResource Input}" Tag="Add a task and press Enter"
                     PreviewMouseDown="OnInputMouseDown" KeyDown="OnTodoKey"/>
            <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="TodoList"/>
            </ScrollViewer>
            <TextBlock x:Name="TodoEmpty" Grid.Row="1" Style="{StaticResource Label}" FontSize="12" Text="All done ✨"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>

          <!-- Apps -->
          <Grid x:Name="PageApps" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <WrapPanel x:Name="AppGrid"/>
            </ScrollViewer>
            <TextBlock x:Name="AppHint" Style="{StaticResource Label}" FontSize="12" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       Text="Click + or drag apps / shortcuts onto the island. Right-click to remove."/>
          </Grid>

          <!-- Shelf: files + clipboard history -->
          <Grid x:Name="PageShelf" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,6">
              <TextBlock Style="{StaticResource Label}" Text="FILES" VerticalAlignment="Center"/>
              <Button Style="{StaticResource Mini}" Content="&#xE74D;" HorizontalAlignment="Right" Click="OnShelfClear"/>
            </Grid>
            <Grid Grid.Row="1">
              <Border Background="{StaticResource Tile}" CornerRadius="14"/>
              <TextBlock x:Name="ShelfHint" Style="{StaticResource Label}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="12,0"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Text="Drop files here to hold them. Drag them out anywhere."/>
              <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                <WrapPanel x:Name="ShelfGrid"/>
              </ScrollViewer>
            </Grid>
            <Grid Grid.Column="2" Margin="0,0,0,6">
              <TextBlock Style="{StaticResource Label}" Text="CLIPBOARD" VerticalAlignment="Center"/>
              <Button Style="{StaticResource Mini}" Content="&#xE74D;" HorizontalAlignment="Right" Click="OnClipClear"/>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="2">
              <TextBlock x:Name="ClipHint" Style="{StaticResource Label}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap" Text="Copied text shows up here (kept in memory only)."/>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ClipList"/>
              </ScrollViewer>
            </Grid>
          </Grid>

          <!-- AI safety: master switch, permissions, memory -->
          <Grid x:Name="PagePrivacy" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,6,0">
                <Border Style="{StaticResource Card}">
                  <Grid Style="{StaticResource Row}" Margin="0,6">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Gemini" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Style="{StaticResource Label}" Text="Off = no AI, no mic, no screen"/>
                    </StackPanel>
                    <ToggleButton x:Name="AiOnBtn" Style="{StaticResource Switch}" Click="OnAiOnToggle"/>
                  </Grid>
                </Border>
                <Grid Margin="4,0,0,4">
                  <TextBlock Style="{StaticResource Label}" Text="WHAT GEMINI MAY DO" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource Link}" Content="Reset" HorizontalAlignment="Right" Click="OnPermReset"/>
                </Grid>
                <Border Style="{StaticResource Card}"><StackPanel x:Name="PermList"/></Border>
                <Grid Margin="4,0,0,4">
                  <TextBlock Style="{StaticResource Label}" Text="MEMORY" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource Link}" Content="Forget everything" HorizontalAlignment="Right" Click="OnForgetAll"/>
                </Grid>
                <TextBlock x:Name="MemHint" Style="{StaticResource Label}" Margin="4,0,0,4"/>
                <StackPanel x:Name="MemList" Margin="4,0,0,0"/>
                <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="4,10,0,2" Opacity="0.8"
                           Text="Privacy: chats aren't saved. Memory, notes and the activity log stay on this PC. Private windows (password managers, banking, incognito) are blacked out before your screen is sent. Google's terms: with a free API key, Google may use what you send to improve its products and human reviewers may read it. With a paid (billing-enabled) key, they don't."/>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- Activity log -->
          <Grid x:Name="PageLog" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,6">
              <TextBlock Style="{StaticResource Label}" Text="EVERYTHING GEMINI DID" VerticalAlignment="Center"/>
              <Button Style="{StaticResource Mini}" Content="&#xE74D;" HorizontalAlignment="Right" Click="OnLogClear"/>
            </Grid>
            <TextBlock x:Name="LogHint" Grid.Row="1" Style="{StaticResource Label}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Nothing yet."/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="LogList" Margin="0,0,6,0"/>
            </ScrollViewer>
          </Grid>

          <!-- Phone remote -->
          <Grid x:Name="PagePhone" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="PhoneQrBox" Width="150" Height="150" CornerRadius="14" Background="White" Padding="8" VerticalAlignment="Center">
              <Grid>
                <Image x:Name="PhoneQr" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <TextBlock x:Name="PhoneQrOff" FontFamily="{StaticResource Icons}" Text="&#xE8EA;" FontSize="40" Foreground="#BBBBBB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <Grid>
                <TextBlock Text="Phone remote" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ToggleButton x:Name="PhoneOnBtn" Style="{StaticResource Switch}" Click="OnPhoneToggle"/>
              </Grid>
              <TextBlock x:Name="PhoneInfo" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,6,0,6"/>
              <TextBlock x:Name="PhoneAddr" FontSize="11" Foreground="#C8FFFFFF" TextWrapping="Wrap"/>
              <Button x:Name="PhoneUnpairBtn" Style="{StaticResource Link}" Content="New QR (unpairs phones)" HorizontalAlignment="Left" Margin="-4,6,0,0" Click="OnPhoneUnpair"/>
            </StackPanel>
          </Grid>

          <!-- Island settings -->
          <Grid x:Name="PageIsland" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,6,0">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <Grid Style="{StaticResource Row}">
                      <TextBlock Text="Accent" FontSize="12" VerticalAlignment="Center"/>
                      <StackPanel x:Name="AccentRow" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Style="{StaticResource Hair}"/>
                    <Grid Style="{StaticResource Row}">
                      <TextBlock Text="Look" FontSize="12" VerticalAlignment="Center"/>
                      <Border Style="{StaticResource SegTrack}">
                        <StackPanel Orientation="Horizontal">
                          <Button x:Name="StyleGlassBtn" Style="{StaticResource Seg}" Content="Glass" CommandParameter="Glass" Click="OnPillStyle"/>
                          <Button x:Name="StyleBlackBtn" Style="{StaticResource Seg}" Content="Black" CommandParameter="Black" Click="OnPillStyle"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                    <Border Style="{StaticResource Hair}"/>
                    <Grid Style="{StaticResource Row}">
                      <TextBlock Text="Talk shortcut" FontSize="12" VerticalAlignment="Center"/>
                      <Border Style="{StaticResource SegTrack}">
                        <StackPanel Orientation="Horizontal">
                          <Button x:Name="KeyAltBtn" Style="{StaticResource Seg}" Content="Alt Alt" CommandParameter="Alt" Click="OnHotkeyPick"/>
                          <Button x:Name="KeyCtrlBtn" Style="{StaticResource Seg}" Content="Ctrl Ctrl" CommandParameter="Ctrl" Click="OnHotkeyPick"/>
                          <Button x:Name="KeyOffBtn" Style="{StaticResource Seg}" Content="Off" CommandParameter="Off" Click="OnHotkeyPick"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <Grid Style="{StaticResource Row}">
                      <TextBlock Text="Voice view" FontSize="12" VerticalAlignment="Center"/>
                      <Border Style="{StaticResource SegTrack}">
                        <StackPanel Orientation="Horizontal">
                          <Button x:Name="VViewSmallBtn" Style="{StaticResource Seg}" Content="Small" CommandParameter="Small" Click="OnVoiceView"/>
                          <Button x:Name="VViewFullBtn" Style="{StaticResource Seg}" Content="Full" CommandParameter="Full" Click="OnVoiceView"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                    <Border Style="{StaticResource Hair}"/>
                    <Grid Style="{StaticResource Row}">
                      <TextBlock Text="Voice" FontSize="12" VerticalAlignment="Center"/>
                      <Border Style="{StaticResource SegTrack}">
                        <StackPanel x:Name="VoicePickRow" Orientation="Horizontal">
                          <Button Style="{StaticResource Seg}" Content="Default" CommandParameter="" Click="OnVoicePick"/>
                          <Button Style="{StaticResource Seg}" Content="Warm" CommandParameter="Aoede" Click="OnVoicePick"/>
                          <Button Style="{StaticResource Seg}" Content="Upbeat" CommandParameter="Puck" Click="OnVoicePick"/>
                          <Button Style="{StaticResource Seg}" Content="Calm" CommandParameter="Kore" Click="OnVoicePick"/>
                          <Button Style="{StaticResource Seg}" Content="Deep" CommandParameter="Charon" Click="OnVoicePick"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                    <Border Style="{StaticResource Hair}"/>
                    <Grid Style="{StaticResource Row}">
                      <TextBlock Text="Sounds" FontSize="12" VerticalAlignment="Center"/>
                      <ToggleButton x:Name="ChimeBtn" Style="{StaticResource Switch}" Click="OnChimeToggle"/>
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <Grid Style="{StaticResource Row}">
                      <TextBlock Text="Daily brief" FontSize="12" VerticalAlignment="Center"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Link}" Content="Show now" Margin="0,0,8,0" Click="OnBriefNow"/>
                        <ToggleButton x:Name="BriefBtn" Style="{StaticResource Switch}" Click="OnBriefToggle"/>
                      </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Hair}"/>
                    <Grid Style="{StaticResource Row}">
                      <TextBlock Text="Start with Windows" FontSize="12" VerticalAlignment="Center"/>
                      <ToggleButton x:Name="StartupBtn" Style="{StaticResource Switch}" Click="OnStartupToggle"/>
                    </Grid>
                    <Border Style="{StaticResource Hair}"/>
                    <Grid Style="{StaticResource Row}">
                      <StackPanel VerticalAlignment="Center" Margin="0,4">
                        <TextBlock Text="Always on top" FontSize="12"/>
                        <TextBlock Style="{StaticResource Label}" Text="Never hide over full-screen apps"/>
                      </StackPanel>
                      <ToggleButton x:Name="AlwaysTopBtn" Style="{StaticResource Switch}" Click="OnAlwaysTopToggle"/>
                    </Grid>
                    <StackPanel x:Name="ScreenRow">
                      <Border Style="{StaticResource Hair}"/>
                      <Grid Style="{StaticResource Row}">
                        <TextBlock x:Name="ScreenText" FontSize="12" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource Link}" Content="Next screen" HorizontalAlignment="Right" Click="OnNextScreen"/>
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <Grid Style="{StaticResource Row}">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontSize="12"/>
                        <TextBlock x:Name="UpdateText" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                      </StackPanel>
                      <Button x:Name="UpdateBtn" Style="{StaticResource Link}" Content="Check for updates" HorizontalAlignment="Right" Click="OnCheckUpdate"/>
                    </Grid>
                    <TextBox x:Name="RepoBox" Style="{StaticResource Input}" Margin="0,0,0,8" Tag="GitHub repo for updates, e.g. yourname/island" PreviewMouseDown="OnInputMouseDown" KeyDown="OnRepoKey" LostFocus="OnRepoSave"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- Notification center -->
          <Grid x:Name="PageNotifs" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,6">
              <TextBlock Text="Notifications" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DndMoon" Style="{StaticResource Mini}" FontSize="12" Content="&#xE708;" Click="OnDndToggle"/>
                <Button Style="{StaticResource Mini}" FontSize="12" Content="&#xE712;" Margin="4,0" Click="OnNotifOptions"/>
                <Button Style="{StaticResource Link}" Content="Clear" Click="OnNotifsClear"/>
              </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,6,0">
                <!-- Do Not Disturb status (only while on) -->
                <Grid x:Name="DndBar" Margin="0,0,0,6" Visibility="Collapsed">
                  <TextBlock x:Name="DndState" FontSize="12" Foreground="#BF5AF2" VerticalAlignment="Center"/>
                  <Button x:Name="DndOffBtn" Style="{StaticResource Link}" Content="Turn off" HorizontalAlignment="Right" Click="OnDndOff"/>
                </Grid>
                <!-- options (folded away behind the ⋯ button) -->
                <Border x:Name="NotifOptions" Style="{StaticResource Card}" Visibility="Collapsed">
                  <StackPanel>
                    <Grid Style="{StaticResource Row}">
                      <TextBlock Text="Do Not Disturb" FontSize="12" VerticalAlignment="Center"/>
                      <Border Style="{StaticResource SegTrack}">
                        <StackPanel Orientation="Horizontal">
                          <Button x:Name="Dnd60Btn" Style="{StaticResource Seg}" Content="1 hour" CommandParameter="60" Click="OnDndFor"/>
                          <Button x:Name="DndTmrBtn" Style="{StaticResource Seg}" Content="Till morning" CommandParameter="tomorrow" Click="OnDndFor"/>
                          <Button x:Name="DndOnBtn" Style="{StaticResource Seg}" Content="On" CommandParameter="0" Click="OnDndFor"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                    <Border Style="{StaticResource Hair}"/>
                    <Grid Style="{StaticResource Row}">
                      <TextBlock Text="Show" FontSize="12" VerticalAlignment="Center"/>
                      <Border Style="{StaticResource SegTrack}">
                        <StackPanel Orientation="Horizontal">
                          <Button x:Name="ModePopBtn" Style="{StaticResource Seg}" Content="Pop-ups" CommandParameter="Popups" Click="OnNotifMode"/>
                          <Button x:Name="ModeSilentBtn" Style="{StaticResource Seg}" Content="Silent" CommandParameter="Silent" Click="OnNotifMode"/>
                          <Button x:Name="ModeOffBtn" Style="{StaticResource Seg}" Content="Off" CommandParameter="Off" Click="OnNotifMode"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                    <TextBlock x:Name="NotifModeHint" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource Hair}"/>
                    <Grid Style="{StaticResource Row}">
                      <StackPanel VerticalAlignment="Center" Margin="0,4">
                        <TextBlock Text="Wait while I'm busy" FontSize="12"/>
                        <TextBlock Style="{StaticResource Label}" Text="Typing, full screen, calls · shown at the next break"/>
                      </StackPanel>
                      <ToggleButton x:Name="HoldBusyBtn" Style="{StaticResource Switch}" Click="OnHoldBusyToggle"/>
                    </Grid>
                    <Border Style="{StaticResource Hair}"/>
                    <Grid Style="{StaticResource Row}">
                      <TextBlock x:Name="WinDndText" Style="{StaticResource Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,70,0"/>
                      <Button Style="{StaticResource Link}" Content="Windows ›" HorizontalAlignment="Right" Click="OnWinDndSettings"/>
                    </Grid>
                  </StackPanel>
                </Border>
                <StackPanel x:Name="NotifList"/>
                <TextBlock x:Name="NotifHint" Style="{StaticResource Label}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="20,8,20,0"
                           Text="You're all caught up."/>
                <TextBlock x:Name="MutedLabel" Style="{StaticResource Label}" Text="MUTED APPS (tap to unmute)" Margin="0,6,0,4"/>
                <WrapPanel x:Name="MutedRow"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- Health check -->
          <Grid x:Name="PageHealth" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,6">
              <StackPanel>
                <TextBlock x:Name="HealthSummary" FontSize="14" FontWeight="SemiBold" Text="Health check"/>
                <TextBlock x:Name="HealthTime" Style="{StaticResource Label}"/>
              </StackPanel>
              <Button x:Name="HealthRunBtn" Style="{StaticResource Link}" Content="Run full test" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnHealthRun"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="HealthList" Margin="0,0,6,0"/>
            </ScrollViewer>
          </Grid>

          <!-- Welcome (first run) -->
          <Grid x:Name="PageWelcome" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel x:Name="Welcome0" VerticalAlignment="Center">
              <TextBlock Text="Hi! This is your Island" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Label}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12"
                         Text="It lives at the top of your screen. Hover over it to open it. Music, timers, notifications, downloads and Gemini all show up here."/>
              <Button Style="{StaticResource Chip}" Content="Next" Tag="1" HorizontalAlignment="Left" Margin="0" Click="OnWelcomeNext"/>
            </StackPanel>
            <StackPanel x:Name="Welcome1" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="Connect Gemini (free)" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Label}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"
                         Text="1. Get a free key from Google AI Studio.   2. Paste it here. It's stored encrypted on this PC."/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Style="{StaticResource Chip}" Content="Get a free key ↗" Margin="0,0,6,0" Click="OnWelcomeGetKey"/>
                <TextBox x:Name="WelcomeKey" Grid.Column="1" Style="{StaticResource Input}" Tag="Paste key" PreviewMouseDown="OnInputMouseDown"/>
                <Button Grid.Column="2" Style="{StaticResource Chip}" Content="Connect" Margin="6,0,0,0" Click="OnWelcomeConnect"/>
              </Grid>
              <Grid Margin="0,8,0,0">
                <TextBlock x:Name="WelcomeMsg" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,100,0"/>
                <Button Style="{StaticResource Chip}" Content="Skip for now" Tag="2" HorizontalAlignment="Right" Margin="0" Click="OnWelcomeNext"/>
              </Grid>
            </StackPanel>
            <StackPanel x:Name="Welcome2" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="You're all set" FontSize="18" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock FontSize="12" Foreground="#C8FFFFFF" Text="•  To talk: say “Hey Gemini” or "/>
                <TextBlock x:Name="WelcomeHotkey" FontSize="12" Foreground="#C8FFFFFF"/>
              </StackPanel>
              <TextBlock FontSize="12" Foreground="#C8FFFFFF" Margin="0,3,0,0" Text="•  Drop files on the island to keep them handy"/>
              <TextBlock FontSize="12" Foreground="#C8FFFFFF" Margin="0,3,0,10" Text="•  Something not working? Controls › Health checks everything"/>
              <Button Style="{StaticResource Chip}" Content="Start using Island" HorizontalAlignment="Left" Margin="0" Click="OnWelcomeDone"/>
            </StackPanel>
            <StackPanel x:Name="WelcomeDots" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"/>
          </Grid>

          <!-- Quick notes -->
          <Grid x:Name="PageNotes" Visibility="Collapsed">
            <Grid x:Name="NotesHost">
              <TextBox x:Name="NotesBox" Style="{StaticResource Area}" Tag="Quick notes… (saved automatically · markdown works: # title, **bold**, - [ ] task)"
                       PreviewMouseDown="OnInputMouseDown" TextChanged="OnNotesChanged" LostKeyboardFocus="OnNotesBlur"/>
              <!-- formatted view while you're not typing; click to edit -->
              <Border x:Name="NotesView" Background="{StaticResource Tile}" CornerRadius="14" Cursor="IBeam" Visibility="Collapsed"
                      PreviewMouseLeftButtonDown="OnNotesViewClick">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,9,10,9">
                  <ContentControl x:Name="NotesMd"/>
                </ScrollViewer>
              </Border>
              <TextBlock x:Name="NotesSaved" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,8"/>
            </Grid>
            <TextBlock x:Name="NotesPopped" Text="Notes are open in the chat window" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>

          <!-- Tools: mirror, colour picker, focus -->
          <Grid x:Name="PageTools" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ToggleButton x:Name="MirrorBtn" Style="{StaticResource Toggle}" Margin="0" Content="&#xE714;" Click="OnMirror"/>
                <TextBlock Text="Mirror" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" Width="92"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource Action}" Margin="0" Content="&#xE790;" Click="OnPickColor"/>
                <TextBlock Text="Pick colour" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="FocusBtn" Style="{StaticResource Toggle}" Margin="0" Content="&#xE708;" Click="OnFocus"/>
                <TextBlock x:Name="FocusText" Text="Focus 25 min" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource Tile}" CornerRadius="14" ClipToBounds="True">
              <Grid>
                <StackPanel x:Name="ToolInfo" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Border x:Name="SwatchBox" Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Center" Visibility="Collapsed"
                          BorderBrush="#40FFFFFF" BorderThickness="1"/>
                  <TextBlock x:Name="ToolHint" Style="{StaticResource Label}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="12,8,12,0"
                             Text="Mirror opens your camera here. Colours you pick are copied as hex."/>
                </StackPanel>
                <Border x:Name="MirrorBox" CornerRadius="14" Visibility="Collapsed">
                  <Border.Background>
                    <ImageBrush x:Name="MirrorImg" Stretch="UniformToFill">
                      <ImageBrush.RelativeTransform><ScaleTransform ScaleX="-1" CenterX="0.5"/></ImageBrush.RelativeTransform>
                    </ImageBrush>
                  </Border.Background>
                </Border>
              </Grid>
            </Border>
          </Grid>

          <!-- AI websites: Claude / ChatGPT / Gemini (the ✦ tab, page 2) -->
          <Grid x:Name="PageWeb" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
              <Border Style="{StaticResource SegTrack}" HorizontalAlignment="Left">
                <StackPanel x:Name="WebSiteRow" Orientation="Horizontal">
                  <Button Style="{StaticResource Seg}" Content="Claude" CommandParameter="claude" Click="OnWebSite"/>
                  <Button Style="{StaticResource Seg}" Content="ChatGPT" CommandParameter="chatgpt" Click="OnWebSite"/>
                  <Button Style="{StaticResource Seg}" Content="Gemini" CommandParameter="gemini" Click="OnWebSite"/>
                </StackPanel>
              </Border>
              <Button Style="{StaticResource Mini}" FontSize="12" Content="&#xE8A7;" HorizontalAlignment="Right" Click="OnWebPop"/>
            </Grid>
            <!-- the page window sits exactly on top of this area -->
            <Border x:Name="WebFrame" Grid.Row="1" CornerRadius="12" Background="#FF1F1E1D"/>
            <StackPanel x:Name="WebPopped" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="Open in the chat window" FontSize="13" HorizontalAlignment="Center"/>
              <Button Style="{StaticResource Link}" Content="Show it" HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnChatPopShow"/>
            </StackPanel>
          </Grid>

          <!-- Assistant -->
          <Grid x:Name="PageAi" Visibility="Collapsed">
            <Grid x:Name="AiMain">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <ScrollViewer x:Name="AiScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="AiChat"/>
              </ScrollViewer>
              <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="AiInput" Style="{StaticResource Input}" Tag="Ask anything…  (double-tap Alt to talk)"
                         PreviewMouseDown="OnInputMouseDown" KeyDown="OnAiKey"/>
                <Button x:Name="ScreenBtn" Grid.Column="1" Style="{StaticResource Ctl}" FontSize="15" Content="&#xE7F4;" Click="OnScreenShare"/>
                <Button x:Name="MicBtn" Grid.Column="2" Style="{StaticResource Ctl}" FontSize="16" Content="&#xE720;" Click="OnMic"/>
                <Button Grid.Column="3" Style="{StaticResource Ctl}" FontSize="14" Content="&#xE8D7;" Click="OnAiSetupToggle"/>
                <Button x:Name="PopBtn" Grid.Column="4" Style="{StaticResource Ctl}" FontSize="13" Content="&#xE8A7;" Click="OnChatPop"/>
              </Grid>
            </Grid>
            <!-- shown while the chat lives in its own window -->
            <StackPanel x:Name="AiPopped" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="Chat is open in its own window" FontSize="13" HorizontalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Style="{StaticResource Link}" Content="Show it" Margin="0,0,14,0" Click="OnChatPopShow"/>
                <Button Style="{StaticResource Link}" Content="Bring it back here" Click="OnChatPopDock"/>
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="AiSetup" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="Connect Gemini" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Label}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"
                         Text="Get a free key at aistudio.google.com → Get API key, then paste it here. It's stored encrypted on this PC."/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="KeyInput" Style="{StaticResource Input}" Tag="Paste API key" PreviewMouseDown="OnInputMouseDown"/>
                <Button Grid.Column="1" Style="{StaticResource Chip}" Content="Save" Margin="6,0,0,0" Click="OnSaveKey"/>
                <Button Grid.Column="2" Style="{StaticResource Chip}" Content="Back" Margin="0" Click="OnAiSetupToggle"/>
              </Grid>
              <TextBlock x:Name="AiSetupMsg" Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>

          <!-- Controls -->
          <Grid x:Name="PageCtl" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <ToggleButton x:Name="WifiBtn" Style="{StaticResource Toggle}" Content="&#xE701;" Click="OnWifi"/>
              <ToggleButton x:Name="BtBtn" Style="{StaticResource Toggle}" Content="&#xE702;" Click="OnBluetooth"/>
              <ToggleButton x:Name="MuteBtn" Style="{StaticResource Toggle}" Content="&#xE74F;" Click="OnMute"/>
              <ToggleButton x:Name="WakeBtn" Style="{StaticResource Toggle}" Content="&#xE720;" Click="OnWakeToggle"/>
              <ToggleButton x:Name="DndBtn" Style="{StaticResource Toggle}" Content="&#xE708;" Click="OnDndToggle"/>
              <Button Style="{StaticResource Action}" Content="&#xE722;" Click="OnScreenshot"/>
              <Button Style="{StaticResource Action}" Content="&#xE72E;" Click="OnLock"/>
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="4,0">
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE767;" FontSize="14" VerticalAlignment="Center"/>
                <Slider x:Name="VolSlider" Grid.Column="1" Style="{StaticResource Sld}" ValueChanged="OnVolSlider"/>
              </Grid>
              <Grid x:Name="BrightRow">
                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE706;" FontSize="14" VerticalAlignment="Center"/>
                <Slider x:Name="BrightSlider" Grid.Column="1" Style="{StaticResource Sld}" ValueChanged="OnBrightSlider"/>
              </Grid>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
  <!-- what Gemini is doing right now ("Opening Chrome…", "✓ Timer 5:00"), just under the island -->
  <Border x:Name="ActChip" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0" Padding="11,4"
          CornerRadius="11" Background="#EE16161A" BorderBrush="#26FFFFFF" BorderThickness="1"
          IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
    <TextBlock x:Name="ActChipText" FontSize="11.5" Foreground="White"/>
  </Border>
  </Grid>
</Window>
